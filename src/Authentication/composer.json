{
    "name": "olobase/authentication",
    "description": "Authentication Module for Olobase App",
    "type": "library",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "firebase/php-jwt": "^6.11",
        "mezzio/mezzio-authentication": "^1.10",
        "mezzio/mezzio-authentication-laminasauthentication": "^1.7"
    },
    "extra": {
        "olobase-module-name": "Authentication",
        "olobase-module-type": "external",
        "olobase-post-install-cmd": [
            "php ./src/Authentication/scripts/install/authentication-adapter.php",
            "php ./src/Authentication/scripts/install/authentication-config.php"
        ],
        "olobase-post-remove-cmd": [
            "php ./src/Authentication/scripts/remove/authentication-files.php",
        ],
        "olobase-post-update-cmd": [
            "php ./src/Authentication/scripts/install/authentication-adapter.php"
        ]
    }
}
